{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "3D Project Tracker: static server",
      "type": "shell",
      "command": "python3 -u -m http.server 5173 --bind 127.0.0.1",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "filament-log",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving HTTP on"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      }
    },
    {
      "label": "3D Project Tracker: Streamlit",
      "type": "shell",
      "command": "streamlit run streamlit_app.py --server.address 127.0.0.1 --server.port 8501",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "filament-log-streamlit",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "You can now view your Streamlit app in your browser"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    }
  ]
}
